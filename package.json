{
  "name": "mai-office",
  "version": "0.1.0",
  "description": "mAI office - a pixel-art office where every AI coding agent (Claude Code, Cursor CLI) is an animated little person you can click and talk to.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:mock": "HARNESS_MODE=mock node server.js",
    "start:claude": "HARNESS_MODE=claude node server.js",
    "screenshots": "node scripts/screenshots.js",
    "test:adapters": "node scripts/test-adapters.js",
    "test:iso": "node scripts/test-iso.js",
    "screenshots:hd": "node scripts/screenshots-hd.js",
    "demo:video": "node scripts/demo-video.js",
    "demo:video:codereview": "node scripts/demo-video.js codereview",
    "demo:videos": "node scripts/demo-video.js && node scripts/demo-video.js codereview"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}
